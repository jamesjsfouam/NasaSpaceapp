# Copia este archivo a .env y completa lo que vayas a usar. Nunca subas .env al repo.

# --- NASA ---
# NASA POWER (fuente principal) no necesita clave.
# Opcional: clave de https://api.nasa.gov para otras APIs de NASA
NASA_API_KEY=DEMO_KEY
# Opcional: cuenta gratuita en https://urs.earthdata.nasa.gov (MODIS, GPM, AIRS... con earthaccess)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Meteomatics (oferta global) ---
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# --- Google Cloud / Firebase (oferta global) ---
# Ruta al JSON de la cuenta de servicio (guárdalo fuera del repo)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
GCS_BUCKET=

# --- Microsoft Azure / Planetary Computer (oferta global) ---
AZURE_STORAGE_CONNECTION_STRING=
# Opcional: Planetary Computer funciona sin clave
PC_SDK_SUBSCRIPTION_KEY=

# --- API ---
CORS_ORIGINS=http://localhost:5173
